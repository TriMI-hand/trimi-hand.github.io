---
interface Props {
  alt?: string;
  priority?: boolean;
}
const { alt = "CAD rendering of the TRIMI assembly", priority = false } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class="assembly-image">
  <img
    src={`${base}data/assembly-views.png`}
    width="1600"
    height="1000"
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
  />
</div>
