---
interface Props {
  title: string;
  description: string;
  kind: "video" | "hardware";
}
const { title, description, kind } = Astro.props;
---

<div class:list={["media-placeholder not-prose", `placeholder-${kind}`]}>
  <div class="placeholder-symbol" aria-hidden="true">
    {
      kind === "video" ? (
        <svg viewBox="0 0 48 48" fill="none">
          <>
            <circle cx="24" cy="24" r="22" stroke="currentColor" />
            <path d="m20 15 14 9-14 9V15Z" fill="currentColor" />
          </>
        </svg>
      ) : (
        <svg
          viewBox="0 0 48 48"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <>
            <path d="m24 3 19 11v21L24 46 5 35V14L24 3Z" />
            <path d="m5 14 19 11 19-11M24 25v21M14 9l19 11" />
          </>
        </svg>
      )
    }
  </div>
  <strong>{title}</strong>
  <span>{description}</span>
</div>
