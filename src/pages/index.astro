---
import { Font } from "astro:assets";
import { Icon } from "astro-icon/components";

import Links from "../components/Links.astro";
import Authors from "../components/Authors.astro";
import Notes from "../components/Notes.astro";
import type { Announcement, Author, Note, Link } from "../types/types";

import Table from "../components/Table.astro";

import "../styles/global.css";
import "../styles/trimi.css";
import "katex/dist/katex-swap.css";

import { Content, frontmatter } from "../paper.mdx";

interface Frontmatter {
  title: string;
  subtitle?: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  announcement?: Announcement;
  links?: Link[];
  description?: string;
  favicon: string;
  thumbnail?: string;
  theme?: "device" | "light" | "dark";
}

const {
  title,
  subtitle,
  authors,
  conference,
  notes,
  announcement,
  links,
  description,
  favicon,
  thumbnail,
  theme = "device",
} = frontmatter as Frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
---

<!doctype html>
<html class="bg-white dark:bg-zinc-900" lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {thumbnail && <meta property="og:image" content={prefix + thumbnail} />}

    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />

    <title>{title}</title>
  </head>
  <body
    id="top"
    class="prose prose-lg prose-zinc dark:prose-invert prose-a:text-blue-500 prose-a:dark:text-blue-300 prose-a:no-underline prose-a:hover:underline prose-a:font-normal prose-code:bg-zinc-200 prose-code:dark:bg-zinc-800 prose-code:text-zinc-800 prose-code:dark:text-zinc-200 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-medium prose-code:before:content-none prose-code:after:content-none max-w-none pt-16 pb-6 font-(family-name:--font-noto-sans)"
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <header
      class="research-header mx-auto mb-12 max-w-[64rem] px-6 text-center"
    >
      {
        announcement && (
          <a
            class="announcement not-prose"
            href={announcement.url}
            target="_blank"
            rel="noopener"
          >
            <Icon name="ri:trophy-line" aria-hidden="true" />
            <span>{announcement.text}</span>
            <Icon name="ri:arrow-right-up-line" aria-hidden="true" />
          </a>
        )
      }
      <h1
        class="research-title text-[clamp(1.75rem,3.8vw,2.75rem)] font-medium tracking-tight"
      >
        {title}
      </h1>
      {subtitle && <p class="research-subtitle">{subtitle}</p>}
      <div class="flex flex-col items-center gap-6">
        {authors.length > 0 && <Authors authors={authors} />}
        {conference && <div>{conference}</div>}
        {notes && <Notes notes={notes} />}
        {links && <Links links={links} />}
      </div>
    </header>
    <main id="main">
      <Content components={{ table: Table }} />
    </main>
    <footer class="template-credit">
      <p>
        Website adapted from <a
          href="https://github.com/SenseRoboticsLab/NAS-GS-Page">NAS-GS-Page</a
        > and Roman Hauksson’s <a
          href="https://github.com/RomanHauksson/academic-project-astro-template"
          >academic project template</a
        >, inspired by <a href="https://nerfies.github.io/">Nerfies</a>.
      </p>
      <p>
        Template adaptation licensed under <a
          href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a
        >. <a href="#top">Back to top ↑</a>
      </p>
    </footer>
    <script>
      import "../scripts/theme.js";
    </script>
  </body>
</html>
